---
interface Props { eyebrow?: string; title: string; intro?: string; center?: boolean; as?: 'h2' | 'h3' }
const { eyebrow, title, intro, center = false, as: Tag = 'h2' } = Astro.props;
---
<div class:list={['reveal max-w-3xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="mt-3">{title}</Tag>
  <span class:list={['rule', center && 'mx-auto']} style={center ? 'transform-origin:center' : undefined}></span>
  {intro && <p class="lead mt-5">{intro}</p>}
</div>
