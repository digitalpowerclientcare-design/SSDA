---
import { brand, contact, pandit, services, telLink, whatsappLink, disclaimer } from '@/data/business';
---
<footer class="mt-20 bg-maroon-black text-ivory/85">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1.4fr]">
    <div>
      <p class="font-display text-2xl text-gold-light">Sri Sai Durga Astrology Centre</p>
      <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed">{brand.tagline}</p>
      <p class="mt-4 text-[0.9rem]">Guidance in {pandit.languages.join(', ')}.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-call !min-h-11" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Call now</a>
        <a class="btn btn-wa !min-h-11" href={whatsappLink()} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
      </div>
    </div>

    <nav aria-label="Services" class="text-[0.95rem]">
      <p class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-gold">Services</p>
      <ul class="grid gap-2">
        {services.slice(0, 6).map((s) => (
          <li><a class="hover:text-gold-light" href={`/services/${s.slug}/`}>{s.title}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-[0.92rem] leading-relaxed">
      <p class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-gold">Visit us</p>
      <address class="not-italic">
        {contact.addressLine},<br />{contact.locality}, {contact.city}, {contact.state} {contact.postalCode}
      </address>
      <p class="mt-3"><a class="underline decoration-gold/60 underline-offset-4 hover:text-gold-light" href={telLink()}>{contact.phoneDisplay}</a></p>
      <p class="mt-1">{contact.hoursDisplay}</p>
      <div class="mt-4 overflow-hidden rounded-lg border border-gold/30">
        <iframe
          src={contact.mapEmbed}
          width="100%" height="200" style="border:0" loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Map to Sri Sai Durga Astrology Centre, Sanjeeva Reddy Nagar, Hyderabad"></iframe>
      </div>
    </div>
  </div>

  <div class="border-t border-gold/20">
    <div class="container-page py-5 text-[0.8rem] text-ivory/60">
      <p class="max-w-3xl">{disclaimer}</p>
      <p class="mt-3">© {new Date().getFullYear()} {brand.name}. All rights reserved. ·
        <a class="hover:text-gold-light" href="/privacy-policy/">Privacy</a> ·
        <a class="hover:text-gold-light" href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
