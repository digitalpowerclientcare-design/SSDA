---
import { brand, contact, services, extraServices, nav, telLink, whatsappLink, disclaimer, pandit } from '@/data/business';
import Logo from '@/components/Logo.astro';
const year = new Date().getFullYear();
// Pages that already carry their own full-size map keep the footer to the address card only.
const ownMap = /^\/(contact|areas\/sanjeeva-reddy-nagar)\//.test(Astro.url.pathname);
---
<footer class="band-deep">
  <div class="container-page pt-14 md:pt-16">
    <p class="eyebrow">Find the centre</p>
    <h2 class="mt-3 text-[clamp(1.5rem,1.1rem+1.6vw,2.1rem)]">Visit {brand.name} in Sanjeeva Reddy Nagar</h2>
    <div class:list={['mt-7 grid gap-5', !ownMap && 'lg:grid-cols-[1.7fr_1fr] lg:gap-8']}>
      {!ownMap && (
        <div class="map-frame relative overflow-hidden rounded-xl border border-white/15 bg-indigo-950">
          <iframe
            src={contact.mapEmbed}
            title={`Map to ${brand.name}, ${contact.locality}, ${contact.city}`}
            class="block h-[17.5rem] w-full sm:h-[22rem] lg:h-[24rem]"
            style="border:0"
            loading="lazy"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
          <a class="map-tap" href={contact.gbpUrl} target="_blank" rel="noopener" aria-label="Open the centre in Google Maps"></a>
        </div>
      )}
      <div class="rounded-xl border border-white/15 bg-white/[0.04] p-5 sm:p-6">
        <address class="not-italic text-[0.98rem] leading-relaxed text-on-dark">
          {contact.addressLine},<br />{contact.locality}, {contact.city}, {contact.state} {contact.postalCode}
        </address>
        <p class="mt-3 text-[0.9rem] text-on-dark-muted">{contact.landmark}</p>
        <p class="mt-3 text-[0.9rem] text-on-dark-muted">{contact.hoursDisplay}</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <a class="btn btn-call" href={telLink()} data-cta="call">Call {contact.phoneDisplay}</a>
          <a class="btn btn-ghost" href={contact.gbpUrl} target="_blank" rel="noopener">Get directions</a>
        </div>
      </div>
    </div>
  </div>
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo size="lg" />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed">{brand.tagline}</p>
      <p class="mt-4 text-[0.9rem] text-on-dark-muted">Consultations in {pandit.languages.join(', ')}.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-call btn-sm" href={telLink()} data-cta="call">Call Pandit Ji</a>
        <a class="btn btn-wa btn-sm" href={whatsappLink()} data-cta="whatsapp">WhatsApp</a>
      </div>
    </div>

    <nav aria-label="Services">
      <p class="eyebrow">Services</p>
      <ul class="mt-4 grid gap-2.5 text-[0.95rem]">
        {services.filter((s) => s.slug !== 'vastu').map((s) => (
          <li><a class="hover:text-brass-300" href={`/services/${s.slug}/`}>{s.title}</a></li>
        ))}
        {extraServices.map((s) => <li><a class="hover:text-brass-300" href={s.path}>{s.title}</a></li>)}
        <li><a class="hover:text-brass-300" href="/services/vastu/">Vastu consultant in Hyderabad</a></li>
      </ul>
    </nav>

    <nav aria-label="Company and guides">
      <p class="eyebrow">Explore</p>
      <ul class="mt-4 grid gap-2.5 text-[0.95rem]">
        <li><a class="hover:text-brass-300" href="/about/">About Pandit Ji</a></li>
        <li><a class="hover:text-brass-300" href="/areas/">Areas we serve</a></li>
        {nav.guides.map((g) => <li><a class="hover:text-brass-300" href={g.href}>{g.label}</a></li>)}
        <li><a class="hover:text-brass-300" href="/contact/">Contact</a></li>
      </ul>
    </nav>

  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 text-[0.8125rem] text-on-dark-muted">
      <p class="max-w-3xl">{disclaimer}</p>
      <p class="mt-3">© {year} {brand.name}. All rights reserved. ·
        <a class="hover:text-brass-300" href="/privacy-policy/">Privacy</a> ·
        <a class="hover:text-brass-300" href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
