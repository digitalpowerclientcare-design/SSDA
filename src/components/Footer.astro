---
import { brand, contact, services, extraServices, nav, telLink, whatsappLink, disclaimer, pandit } from '@/data/business';
import Logo from '@/components/Logo.astro';
const year = new Date().getFullYear();
---
<footer class="band-deep">
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
    <div>
      <Logo size="lg" />
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed">{brand.tagline}</p>
      <p class="mt-4 text-[0.9rem] text-on-dark-muted">Consultations in {pandit.languages.join(', ')}.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-call btn-sm" href={telLink()} data-cta="call">Call Pandit Ji</a>
        <a class="btn btn-wa btn-sm" href={whatsappLink()} data-cta="whatsapp">WhatsApp</a>
      </div>
    </div>

    <nav aria-label="Services">
      <p class="eyebrow">Services</p>
      <ul class="mt-4 grid gap-2.5 text-[0.95rem]">
        {services.filter((s) => s.slug !== 'vastu').map((s) => (
          <li><a class="hover:text-brass-300" href={`/services/${s.slug}/`}>{s.title}</a></li>
        ))}
        {extraServices.map((s) => <li><a class="hover:text-brass-300" href={s.path}>{s.title}</a></li>)}
        <li><a class="hover:text-brass-300" href="/services/vastu/">Vastu consultant in Hyderabad</a></li>
      </ul>
    </nav>

    <nav aria-label="Company and guides">
      <p class="eyebrow">Explore</p>
      <ul class="mt-4 grid gap-2.5 text-[0.95rem]">
        <li><a class="hover:text-brass-300" href="/about/">About Pandit Ji</a></li>
        <li><a class="hover:text-brass-300" href="/areas/">Areas we serve</a></li>
        {nav.guides.map((g) => <li><a class="hover:text-brass-300" href={g.href}>{g.label}</a></li>)}
        <li><a class="hover:text-brass-300" href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="text-[0.95rem] leading-relaxed">
      <p class="eyebrow">Visit the centre</p>
      <address class="mt-4 not-italic">
        {contact.addressLine},<br />{contact.locality}, {contact.city}, {contact.state} {contact.postalCode}
      </address>
      <p class="mt-3"><a class="text-on-dark underline decoration-brass-500/60 underline-offset-4 hover:text-brass-300" href={telLink()}>{contact.phoneDisplay}</a></p>
      <p class="mt-1 text-on-dark-muted">{contact.hoursDisplay}</p>
      <p class="mt-3"><a class="link-arrow" href={contact.gbpUrl} target="_blank" rel="noopener">Open in Google Maps <span aria-hidden="true">→</span></a></p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 text-[0.8125rem] text-on-dark-muted">
      <p class="max-w-3xl">{disclaimer}</p>
      <p class="mt-3">© {year} {brand.name}. All rights reserved. ·
        <a class="hover:text-brass-300" href="/privacy-policy/">Privacy</a> ·
        <a class="hover:text-brass-300" href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
