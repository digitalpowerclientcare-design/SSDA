---
import { brand, contact, pandit, services, telLink, whatsappLink, disclaimer } from '@/data/business';
const year = new Date().getFullYear();
---
<footer class="band-night mt-4 text-white/80">
  <div class="container-page relative z-[1] grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1.3fr]">
    <div>
      <p class="font-display text-2xl text-white">Sri Sai Durga <span class="text-gold-hi">Astrology Centre</span></p>
      <p class="mt-3 max-w-sm text-[0.95rem] leading-relaxed text-white/70">{brand.tagline}</p>
      <p class="mt-4 text-[0.9rem] text-white/70">Guidance in {pandit.languages.join(', ')}.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-gold !min-h-11" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Call now</a>
        <a class="btn btn-wa !min-h-11" href={whatsappLink()} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
      </div>
    </div>

    <nav aria-label="Services" class="text-[0.95rem]">
      <p class="mb-3 text-[0.72rem] font-bold uppercase tracking-[0.18em] text-gold-hi">Services</p>
      <ul class="grid gap-2 text-white/75">
        {services.slice(0, 6).map((s) => (
          <li><a class="transition hover:text-gold-hi" href={`/services/${s.slug}/`}>{s.title}</a></li>
        ))}
        <li><a class="transition hover:text-gold-hi" href="/services/">All services →</a></li>
      </ul>
    </nav>

    <div class="text-[0.92rem] leading-relaxed text-white/75">
      <p class="mb-3 text-[0.72rem] font-bold uppercase tracking-[0.18em] text-gold-hi">Visit us</p>
      <address class="not-italic">
        {contact.addressLine},<br />{contact.locality}, {contact.city}, {contact.state} {contact.postalCode}
      </address>
      <p class="mt-3"><a class="underline decoration-gold/60 underline-offset-4 hover:text-gold-hi" href={telLink()}>{contact.phoneDisplay}</a></p>
      <p class="mt-1">{contact.hoursDisplay}</p>
      <div class="mt-4 overflow-hidden rounded-xl border border-white/15">
        <iframe
          src={contact.mapEmbed}
          width="100%" height="180" style="border:0" loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Map to Sri Sai Durga Astrology Centre, Sanjeeva Reddy Nagar, Hyderabad"></iframe>
      </div>
    </div>
  </div>

  <div class="border-t border-white/12">
    <div class="container-page relative z-[1] py-5 text-[0.8rem] text-white/55">
      <p class="max-w-3xl">{disclaimer}</p>
      <p class="mt-3">© {year} {brand.name}. All rights reserved. ·
        <a class="hover:text-gold-hi" href="/privacy-policy/">Privacy</a> ·
        <a class="hover:text-gold-hi" href="/terms/">Terms</a>
      </p>
    </div>
  </div>
</footer>
