---
import { telLink, whatsappLink } from '@/data/business';
---
<div id="sticky-bar" class="sticky-bar fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 gap-2 px-3 pt-2.5 pb-2.5 md:hidden">
  <a href={telLink()} data-cta="call" class="btn btn-call !min-h-12 !px-3 !rounded-xl">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    Call
  </a>
  <a href={whatsappLink()} data-cta="whatsapp" class="btn btn-wa !min-h-12 !px-3 !rounded-xl">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.800-1.200A9 9 0 1 0 12 3Z"/><path d="M9 8.500c0 3.500 2.500 6 6 6l1.200-1.500-2-1-1 .8a4 4 0 0 1-2-2l.8-1-1-2L9 8.500Z"/></svg>
    WhatsApp
  </a>
</div>
<div class="h-[4.75rem] md:hidden" aria-hidden="true"></div>
