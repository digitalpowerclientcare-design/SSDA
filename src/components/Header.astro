---
import { brand, contact, telLink } from '@/data/business';
---
<header class="sticky top-0 z-40 border-b border-ink/5 bg-cream/85 backdrop-blur-md">
  <div class="container-page flex items-center justify-between gap-4 py-3.5">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${brand.name} - home`}>
      <img src="/images/logo.png" alt={brand.name} width="150" height="56" class="h-10 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 text-[0.93rem] font-semibold text-ink-2 lg:flex" aria-label="Primary">
      <a class="transition-colors hover:text-flame" href="/">Home</a>
      <a class="transition-colors hover:text-flame" href="/services/">Services</a>
      <a class="transition-colors hover:text-flame" href="/about/">About Pandit Ji</a>
      <a class="transition-colors hover:text-flame" href="/contact/">Contact</a>
    </nav>

    <a class="btn btn-gold hidden !min-h-11 !px-5 !py-2 !text-[0.9rem] sm:inline-flex" href={telLink()} data-cta="call">
      <span aria-hidden="true">☎</span> {contact.phoneDisplay}
    </a>
  </div>
</header>
