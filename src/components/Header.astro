---
import { brand, contact, telLink } from '@/data/business';
---
<header class="sticky top-0 z-40 border-b border-gold/30 bg-ivory/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label={`${brand.name} - home`}>
      {/* TODO(client): supply a higher-resolution logo; current is 300x200. */}
      <img src="/images/logo.png" alt={brand.name} width="150" height="56" class="h-12 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 text-[0.95rem] font-medium text-maroon md:flex" aria-label="Primary">
      <a class="hover:text-kumkum" href="/">Home</a>
      <a class="hover:text-kumkum" href="/services/">Services</a>
      <a class="hover:text-kumkum" href="/about/">About Pandit Ji</a>
      <a class="hover:text-kumkum" href="/contact/">Contact</a>
    </nav>

    <a class="btn btn-call hidden sm:inline-flex !min-h-11 !py-2 !text-[0.9rem]" href={telLink()} data-cta="call">
      <span aria-hidden="true">☎</span> {contact.phoneDisplay}
    </a>
  </div>
</header>
