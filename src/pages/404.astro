---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { telLink, contact } from '@/data/business';
---
<BaseLayout title="Page not found | Sri Sai Durga Astrology Centre" description="This page could not be found. Return to the Sri Sai Durga Astrology Centre home page or call the centre." canonicalPath="/404/" noindex>
  <section class="band-deep relative overflow-hidden" style="background: radial-gradient(70% 90% at 50% 0%, #141B42 0%, #070B1E 70%);">
    <div class="hero-glow opacity-50" aria-hidden="true"></div>
    <div class="container-page relative grid min-h-[60vh] place-content-center py-24 text-center">
      <p class="eyebrow hero-in hero-in-1">Page not found</p>
      <h1 class="hero-in hero-in-2 mx-auto mt-5 max-w-2xl">We could not find that page, but the right one is close.</h1>
      <span class="rule hero-in hero-in-2 mx-auto" style="transform-origin:center"></span>
      <div class="hero-in hero-in-4 mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn btn-call" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href={telLink()} data-cta="call">Call {contact.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
