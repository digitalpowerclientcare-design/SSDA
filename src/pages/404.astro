---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { telLink, whatsappLink } from '@/data/business';
---
<BaseLayout title="Page not found" description="This page could not be found." canonicalPath="/404/" noindex>
  <section class="container-page py-24 text-center">
    <p class="font-display text-6xl text-gold-deep">ॐ</p>
    <h1 class="mt-4 text-[2.2rem]">This page could not be found</h1>
    <p class="mt-3 text-ink-2">Let us guide you back.</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a class="btn btn-line" href="/">Go to home</a>
      <a class="btn btn-primary" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Call us</a>
      <a class="btn btn-wa" href={whatsappLink()} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
    </div>
  </section>
</BaseLayout>
