---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { brand, pandit, contact, ids, reviewsUrl, telLink, whatsappLink } from '@/data/business';
import { buildGraph, organizationSchema, localBusinessSchema, personSchema, faqSchema, breadcrumbSchema, abs } from '@/lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'About Pandit Ji', url: '/about/' }];
const reviewCount = brand.reviews.count.toLocaleString('en-IN');

const faqs = [
  { question: 'Who is Pandit Sri Santosh Sharma Ji?', answer: `He is a Vedic astrologer and Vastu consultant who has practised in Hyderabad for more than 35 years. You meet him at Sri Sai Durga Astrology Centre in ${contact.locality}, or speak to him on a phone or video call.` },
  { question: 'What does Pandit Ji help with?', answer: 'Kundli matching, marriage timing and delay, career and business questions, Muhurtham (auspicious dates), doshas, numerology, and Vastu for homes, flats, offices and plots.' },
  { question: 'Is a pandit the same as an astrologer?', answer: 'Not always. Pandit is a title of respect for a learned person, and many pandits are priests. A jyotishi (astrologer) is the one who reads charts. Pandit Ji is addressed as Pandit, and the work you come to him for is Jyotish and Vastu.' },
  { question: 'Will I be pushed into remedies or purchases?', answer: 'No. If your chart suggests a remedy, Pandit Ji tells you what it is and why, and you can decline. If it suggests nothing, he says that.' },
  { question: 'Can Pandit Ji guarantee a result?', answer: 'No, and he will not try. A chart can show which periods look supportive and which look slow. It cannot name a day or promise an outcome. Be careful with anyone who does.' },
  { question: 'Which languages are consultations held in?', answer: `${pandit.languages.slice(0, -1).join(', ')} and ${pandit.languages[pandit.languages.length - 1]}. Tell us which one you want when you call, and the session is booked in that language.` },
  { question: 'Can I consult Pandit Ji online from outside Hyderabad?', answer: 'Yes. Sessions run over phone or video as well as in person, so a relative in another city or country can join the call. Call or WhatsApp to fix a time.' },
];

const jsonLd = buildGraph(
  organizationSchema(), localBusinessSchema(), personSchema(),
  { '@type': 'AboutPage', '@id': abs('/about/#aboutpage'), url: abs('/about/'), name: `About ${pandit.name}`, mainEntity: { '@id': ids.person }, isPartOf: { '@id': ids.website } },
  faqSchema(faqs, abs('/about/')),
  breadcrumbSchema(crumbs),
);

const method = [
  { t: 'Lagna, the rising sign', d: 'Everything starts with the sign that was rising on the eastern horizon when you were born. It decides which house is which, and a birth time that is off by a couple of hours can change it.' },
  { t: 'The nine grahas in your chart', d: 'Next come the planets, Rahu and Ketu included: which house each one sits in, which sign, and how strong it is there.' },
  { t: 'Dasha periods and timing', d: 'Pandit Ji reads the dasha running now against the chart. That is the part that speaks to timing. Without it, a chart only tells you what is possible.' },
  { t: 'Kundli matching: both charts together', d: 'For a marriage match the two charts go side by side. The 36-point Guna score is one part of that reading.' },
  { t: 'Dosha checks come first', d: 'If a dosha shows up, Pandit Ji first looks at whether any of its cancellation conditions apply.' },
];

---
<BaseLayout
  title="Vedic Astrologer in Hyderabad | Pandit Santosh Sharma"
  description="Meet Pandit Sri Santosh Sharma Ji, a Vedic astrologer and Vastu consultant in Hyderabad with 35+ years of practice. Readings in Telugu, Hindi or English."
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="About Pandit Ji"
    title="Pandit Sri Santosh Sharma Ji: Vedic Astrologer in Hyderabad"
    intro="Pandit Ji has read charts and floor plans in Hyderabad for more than 35 years. You can meet him at the centre in Sanjeeva Reddy Nagar, or speak to him on a call."
    crumbs={crumbs}
    ctas
  />

  <!-- ============ PROFILE ============ -->
  <section class="band-light section">
    <div class="container-page grid items-start gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <!-- typographic profile panel (no photo yet) -->
      <aside class="band-dark reveal relative overflow-hidden rounded-lg border border-brass-500/35 p-8 md:p-10" aria-label="Profile summary">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="relative">
          <p class="eyebrow">Vedic astrologer and Vastu consultant</p>
          <p class="mt-4 font-display text-[clamp(1.75rem,1.4rem+1.4vw,2.4rem)] font-medium leading-[1.14] text-[var(--fg)]">{pandit.name}</p>
          <span class="rule"></span>
          <p class="numeral mt-8 text-[clamp(4rem,3rem+4vw,6rem)]">35+</p>
          <p class="mt-2 text-[0.95rem] uppercase tracking-[0.14em] text-on-dark-muted">Years of practice</p>
          <p class="mt-8 text-[1rem]">{contact.locality}, {contact.city}, {contact.state}</p>
          <p class="mt-1 text-[0.95rem] text-on-dark-muted">{pandit.languages.join(' · ')}</p>
          <p class="mt-6 border-t border-white/12 pt-5 text-[0.95rem]">
            <span class="text-[#E8B923]" aria-hidden="true">★★★★★</span>
            <span class="sr-only">5 out of 5 stars,</span>
            {brand.reviews.rating.toFixed(1)} on Google ·
            <a class="underline decoration-brass-500/50 underline-offset-4 hover:text-brass-300" href={reviewsUrl} target="_blank" rel="noopener">{reviewCount} reviews</a>
          </p>
        </div>
      </aside>

      <div class="reveal">
        <p class="eyebrow">Who you will be speaking to</p>
        <h2 class="mt-3">Vedic astrologer and Vastu consultant: meet Pandit Ji</h2>
        <span class="rule"></span>
        <div class="prose-site mt-6">
          <p class="lead">People pick up the phone for a handful of reasons. A marriage that has not happened yet. A job that has stopped moving. A house they are about to buy, or about to walk into for the first time. A decision the family cannot agree on.</p>
          <!-- INTERVIEW Q3: who calls first and what they are most afraid of, in Pandit Ji's own words (1-2 sentences, no numbers) -->
          <p>Whichever it is, you talk to Pandit Sri Santosh Sharma Ji himself. He reads the chart and tells you what it shows. If it shows something difficult, he says so. If it shows nothing to worry about, he says that too, and he doesn't dress it up either way.</p>
          <p>If you are looking for an experienced astrologer in Hyderabad, the fact to go on is 35 years of practice in Jyotish and Vastu Shastra. Whether he is the right person for your question is for the first call to settle, so ask what you want to know and see if the answers make sense to you.</p>
          <!-- INTERVIEW Q4: do people usually see someone else before him, and what do they tell him about it? Only publish if he confirms and is happy for it to be quoted -->
        </div>
        <dl class="fact-table mt-10">
          <div><dt>Practice</dt><dd>Vedic astrology (Jyotish Shastra) and Vastu Shastra, {pandit.yearsExperience}+ years</dd></div>
          <div><dt>Specialisation</dt><dd>Kundli matching, marriage, career, business, Muhurtham, doshas, Vastu, numerology</dd></div>
          <div><dt>Languages</dt><dd>{pandit.languages.join(', ')}</dd></div>
          <div><dt>Consultation</dt><dd>In person at Sanjeeva Reddy Nagar, or by phone and video</dd></div>
          <div><dt>Location</dt><dd>{contact.locality}, {contact.city} {contact.postalCode}</dd></div>
          <div><dt>Fees</dt><dd>Not listed on the site. Ask when you call, and you hear the amount before you book.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ METHOD ============ -->
  <section class="band-white section">
    <div class="container-page">
      <SectionHead eyebrow="Reading the chart" title="Jyotish (Jyothisham): how Pandit Ji reads a Vedic birth chart, step by step" intro="A birth chart is a map of where the planets stood at the moment you were born. Reading it follows an order, and this is the order." />
      <!-- TODO(client): name the classical texts or tradition Pandit Ji follows, only if he confirms them. -->
      <!-- INTERVIEW Q1: how he learned Jyotish and Vastu, and from whom (names or relationships only if he is happy for them to appear) -->
      <!-- INTERVIEW Q2: the first chart he remembers reading for someone and what he learned from it -->
      <ol class="mt-14 grid gap-px overflow-hidden rounded-lg border border-[var(--color-line-light)] bg-[var(--color-line-light)] sm:grid-cols-2 lg:grid-cols-5">
        {method.map((m, i) => (
          <li class="reveal flex flex-col gap-3 bg-white p-7">
            <span class="numeral text-[1.5rem] !text-[var(--color-brass-700)]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[1.375rem]">{m.t}</h3>
            <p class="text-[0.95rem]">{m.d}</p>
          </li>
        ))}
      </ol>
      <div class="reveal prose-site mt-12">
        <p>You will see the same craft spelled Jyotish, Jyotishi, Jyothisham or Jyothishyam, depending on who is writing. It is one tradition. If a word in a reading is new to you, the <a href="/glossary/">astrology glossary</a> covers most of them, and <a href="/how-a-consultation-works/">how a consultation works</a> walks through a session from the first call.</p>
        <p>Where Pandit Ji trained, and which texts he works from, is something to ask him directly. We would rather you hear it in his words than read our summary of it.</p>
      </div>
    </div>
  </section>

  <!-- ============ APPROACH ============ -->
  <section class="band-dark section">
    <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <SectionHead eyebrow="How he works" title="How Pandit Ji works in Hyderabad: nothing to sell but the consultation" />
      <div class="reveal grid gap-5">
        <p>Pandit Ji does not go looking for a problem that is not in your chart. If the chart shows nothing that needs fixing, he says so.</p>
        <p>When the chart shows nothing that needs fixing, Pandit Ji says so. When a remedy does make sense, he tells you what it is and why he suggests it, and you can say no. A chart can show which years look supportive and which look slow, but it cannot guarantee an outcome, and he won't pretend it can.</p>
        <p>He speaks {pandit.languages.slice(0, -1).join(', ')} and {pandit.languages[pandit.languages.length - 1]}, so use the one you think in.</p>
        <!-- INTERVIEW Q15: what he refuses to do or say (fixed dates, illness advice, rituals he does not believe in), in his own words -->
        <!-- INTERVIEW Q16: when he tells someone there is nothing wrong in the chart and no remedy is needed, and what happens next -->
      </div>
    </div>
  </section>

  <!-- ============ WHAT TO EXPECT ============ -->
  <section class="band-light section">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHead eyebrow="What to expect" title="What an astrology consultation with Pandit Ji looks like, in person or online" />
      <div class="reveal prose-site">
        <p>Pandit Ji works out your chart before the session, from the date, time and place of birth you give when you call. You don't sit and wait while it is calculated.</p>
        <p>In the session, Pandit Ji goes through what the chart supports and what it does not, then moves to the question you came with and tells you which periods look better for it and which look slower, with the reason behind each. You get periods. You don't get a date. If a remedy makes sense he explains it, and if not he says that.</p>
        <p>Come to Sanjeeva Reddy Nagar, or take the session by phone or video. Write your questions down beforehand, because it is easy to forget the important one once you are talking.</p>
        <!-- INTERVIEW Q5: what a normal week looks like (people seen, phone or video, how he prepares a chart). Do not publish numbers unless he confirms them -->
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="band-white section">
    <div class="container-page grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <SectionHead eyebrow="Questions" title="Questions about Pandit Ji, his Jyotish and Vastu work, and booking" />
      <div class="reveal"><FaqList faqs={faqs} openFirst /></div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

