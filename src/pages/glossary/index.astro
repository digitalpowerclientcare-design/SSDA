---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand, telLink, whatsappLink } from '@/data/business';
import { buildGraph, organizationSchema, breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Glossary', url: '/glossary/' }];

/* Terms grounded in what this site already talks about - no invented
   definitions, each links to the real service page it supports. */
const terms = [
  {
    term: 'Ashtakoot / Guna Milan',
    def: 'The 36-point traditional system for comparing two birth charts before marriage, examining eight factors of compatibility rather than a single score.',
    href: '/services/kundli-matching/',
  },
  {
    term: 'Dasha',
    def: 'A planetary time period in a birth chart, used to understand timing - when a change in career, marriage or circumstance is more or less likely.',
    href: '/services/career-astrology/',
  },
  {
    term: 'Kaal Sarp Dosha',
    def: 'A chart placement where all seven visible planets sit between Rahu and Ketu. Its significance is often over-stated - many charts carry a mild version with no real remedy required.',
    href: '/services/dosha-remedies/',
  },
  {
    term: 'Kundli (Janam Kundli)',
    def: 'A birth chart, prepared from date, time and place of birth. The starting point for every reading offered here.',
    href: '/services/kundli-matching/',
  },
  {
    term: 'Mangal Dosha (Kuja Dosha)',
    def: 'A placement of Mars said to affect marriage. Classical texts list several cancellation conditions, so a flagged dosha does not automatically mean a difficult match.',
    href: '/services/dosha-remedies/',
  },
  {
    term: 'Muhurtham',
    def: 'An auspicious date and time for an important event - a wedding, a gruhapravesham, a business opening - chosen using the panchangam and the parties\' charts.',
    href: '/services/muhurtham/',
  },
  {
    term: 'Nakshatra',
    def: 'One of 27 lunar constellations. A person\'s birth Nakshatra is used alongside their Rashi in marriage matching and chart reading.',
    href: '/services/kundli-matching/',
  },
  {
    term: 'Navagraha',
    def: 'The nine planetary bodies used in Vedic astrology - the Sun, Moon, Mars, Mercury, Jupiter, Venus, Saturn, Rahu and Ketu - whose positions form the basis of a chart reading.',
    href: '/services/dosha-remedies/',
  },
  {
    term: 'Panchangam',
    def: 'A traditional Hindu calendar combining lunar and solar positions, used to calculate auspicious timings for Muhurtham.',
    href: '/services/muhurtham/',
  },
  {
    term: 'Rashi (Moon Sign)',
    def: 'The zodiac sign the Moon occupied at birth. Distinct from a Sun sign, and the basis for the Rashi used in Kundli matching.',
    href: '/services/kundli-matching/',
  },
  {
    term: 'Vastu Dosha',
    def: 'A directional imbalance in a home or office layout - a kitchen in the wrong corner, an obstructed entrance. Most have a workable correction that does not involve construction.',
    href: '/services/vastu/',
  },
  {
    term: 'Birth Number / Destiny Number',
    def: 'Two core figures in numerology, drawn from a birth date and a full name, used alongside a chart reading rather than in place of one.',
    href: '/services/numerology/',
  },
];

const jsonLd = buildGraph(organizationSchema(), breadcrumbSchema(crumbs));
---
<BaseLayout
  title={`Vedic Astrology Glossary | ${brand.name}`}
  description="Plain-language definitions of the Vedic astrology and Vastu terms used across our Hyderabad consultations - Kundli, Guna Milan, Dasha, Muhurtham, Vastu Dosha and more."
  canonicalPath="/glossary/"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="label">Glossary</p>
        <h1 class="mt-3 text-[2.2rem]">Terms used in a Vedic astrology consultation</h1>
        <p class="mt-4 text-ink-2">Plain definitions for the words that come up most in our consultations - each links to the relevant service.</p>
      </div>

      <div class="mt-11 grid gap-4 sm:grid-cols-2">
        {terms.map((t) => (
          <div class="card reveal p-6">
            <h2 class="text-[1.1rem] text-ink">{t.term}</h2>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-2">{t.def}</p>
            <a class="mt-3 inline-flex text-[0.88rem] font-bold text-flame" href={t.href}>Related service →</a>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Ask Pandit Ji directly</a>
        <a class="btn btn-wa" href={whatsappLink()} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
