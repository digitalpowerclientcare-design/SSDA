---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand, contact, services, telLink, whatsappLink } from '@/data/business';
import { buildGraph, organizationSchema, localBusinessSchema, servicesSchema, breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }];
const jsonLd = buildGraph(organizationSchema(), localBusinessSchema(), ...servicesSchema(), breadcrumbSchema(crumbs));
---
<BaseLayout
  title={`Astrology Services in Hyderabad | ${brand.name}`}
  description="Vedic astrology services in Hyderabad with Pandit Sri Santosh Sharma Ji - kundli matching, marriage & career guidance, business astrology, muhurtham, Vastu, dosha remedies and numerology. Call or WhatsApp."
  canonicalPath="/services/"
  jsonLd={jsonLd}
>
  <section class="container-page py-14">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Our services</p>
      <h1 class="mt-3 text-[2.4rem]">Vedic astrology services in Hyderabad</h1>
      <p class="mt-4 text-ink-soft">Guidance for every important phase of life, with {contact.hoursDisplay.toLowerCase()} availability and consultations in Telugu, Hindi, Kannada and English.</p>
    </div>
    <div class="mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a href={`/services/${s.slug}/`} class="group rounded-2xl border border-gold/30 bg-white/70 p-6 transition hover:border-gold hover:shadow-[0_10px_30px_-16px_rgba(90,26,26,0.4)]">
          <div class="mb-4 grid h-11 w-11 place-items-center rounded-full border border-gold text-kumkum" aria-hidden="true">✦</div>
          <h2 class="text-[1.3rem] text-maroon-deep">{s.title}</h2>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{s.summary}</p>
          <span class="mt-4 inline-block text-[0.9rem] font-semibold text-kumkum group-hover:underline">Learn more →</span>
        </a>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap justify-center gap-3">
      <a class="btn btn-call" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Call {contact.phoneDisplay}</a>
      <a class="btn btn-wa" href={whatsappLink()} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
    </div>
  </section>
</BaseLayout>
