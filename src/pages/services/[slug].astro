---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand, contact, pandit, services, getService, telLink, whatsappLink, disclaimer } from '@/data/business';
import { buildGraph, organizationSchema, localBusinessSchema, personSchema, faqSchema, breadcrumbSchema, abs } from '@/lib/schema';

export const getStaticPaths = (() =>
  services.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }))
) satisfies GetStaticPaths;

const { slug } = Astro.props as { slug: string };
const s = getService(slug)!;
const path = `/services/${s.slug}/`;

const faqs = [
  { question: `How do I book ${s.title.toLowerCase()} in Hyderabad?`, answer: `Call or WhatsApp ${contact.phoneDisplay}. Share your birth details and Pandit Sri Santosh Sharma Ji's team will arrange a time - in person at Sanjeeva Reddy Nagar or online.` },
  { question: `Which languages is the consultation available in?`, answer: `Telugu, Hindi, Kannada and English. Mention your preferred language when you call.` },
  { question: `Are guaranteed results promised?`, answer: `No. Guidance is honest and practical, with remedies suggested only where the chart genuinely indicates them - never fear or false promises.` },
];

const other = services.filter((x) => x.slug !== s.slug).slice(0, 4);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }, { name: s.title, url: path }];
const jsonLd = buildGraph(
  organizationSchema(), localBusinessSchema(), personSchema(),
  {
    '@type': 'Service', '@id': abs(`${path}#service`), name: `${s.title} in ${contact.city}`,
    description: s.leadAnswer, serviceType: s.title, url: abs(path),
    provider: { '@id': abs('/#localbusiness') }, areaServed: { '@type': 'City', name: contact.city },
  },
  faqSchema(faqs, abs(path)), breadcrumbSchema(crumbs),
);
---
<BaseLayout
  title={`${s.title} in Hyderabad | ${brand.name}`}
  description={`${s.leadAnswer.slice(0, 155)}`}
  canonicalPath={path}
  jsonLd={jsonLd}
>
  <nav class="container-page pt-6 text-[0.85rem] text-ink-2" aria-label="Breadcrumb">
    <a class="hover:text-flame" href="/">Home</a> ·
    <a class="hover:text-flame" href="/services/">Services</a> ·
    <span class="text-gold-deep">{s.title}</span>
  </nav>

  <section class="container-page pb-10 pt-6">
    <div class="mx-auto max-w-3xl">
      <p class="label reveal">{contact.locality}, Hyderabad</p>
      <h1 class="reveal-1 mt-3 text-[2.3rem] sm:text-[2.7rem]">{s.title} in Hyderabad</h1>

      <!-- answer-first block (AEO) -->
      <div class="reveal-2 mt-6 rounded-2xl border border-gold/40 bg-card p-6">
        <p class="text-[1.06rem] leading-relaxed text-ink">{s.leadAnswer}</p>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={telLink()} data-cta="call"><span aria-hidden="true">☎</span> Call {contact.phoneDisplay}</a>
        <a class="btn btn-wa" href={whatsappLink(`Namaste, I would like guidance on ${s.title}.`)} data-cta="whatsapp"><span aria-hidden="true">✆</span> WhatsApp</a>
      </div>

      <h2 class="reveal mt-12 text-[1.6rem]">What this consultation covers</h2>
      <ul class="mt-4 grid gap-3">
        {s.bullets.map((b) => (
          <li class="flex gap-3"><span class="mt-1 text-gold-deep" aria-hidden="true">✦</span><span>{b}</span></li>
        ))}
      </ul>

      <p class="mt-8 leading-relaxed text-ink-2">
        Consultations are held with {pandit.name} - 35+ years of Vedic astrology experience - in Telugu, Hindi, Kannada or English, at our {contact.locality} centre in Hyderabad or online by phone and video. {disclaimer}
      </p>

      <h2 class="reveal mt-12 text-[1.6rem]">Questions</h2>
      <div class="mt-4 divide-y divide-gold/25 border-y border-gold/25">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-ink marker:content-['']">
              <span>{f.question}</span><span class="text-gold-deep transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink-2">{f.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-12">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-gold-deep">Other services</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {other.map((o) => (<a class="btn btn-line !min-h-10 !py-2 !text-[0.9rem]" href={`/services/${o.slug}/`}>{o.title}</a>))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
